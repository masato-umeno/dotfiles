#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_dir="${repo_root}/home/.codex"
target_dir="${CODEX_HOME:-${HOME}/.codex}"

if [[ ! -d "$source_dir" ]]; then
  echo "Codex source directory is missing: $source_dir" >&2
  exit 1
fi

mkdir -p "$target_dir"

rsync -a --chmod=Du+w,Fu+w \
  --exclude 'auth.json' \
  --exclude '.codex-global-state.json*' \
  --exclude '.personality_migration' \
  --exclude 'ambient-suggestions/' \
  --exclude 'cache/' \
  --exclude 'config.toml' \
  --exclude 'installation_id' \
  --exclude 'log/' \
  --exclude 'logs/' \
  --exclude 'logs_*.sqlite*' \
  --exclude 'memories/' \
  --exclude 'models_cache.json' \
  --exclude 'plugins/cache/' \
  --exclude 'rules/default.rules' \
  --exclude 'session_index.jsonl' \
  --exclude 'sessions/' \
  --exclude 'shell_snapshots/' \
  --exclude 'skills/.system/' \
  --exclude 'sqlite/' \
  --exclude 'state_*.sqlite*' \
  --exclude 'tmp/' \
  --exclude 'vendor_imports/' \
  --exclude 'version.json' \
  --exclude 'history*' \
  --exclude '*.sqlite*' \
  --exclude '*.tmp' \
  --exclude '*.lock' \
  "${source_dir}/" "$target_dir/"

echo "Synced Codex files to $target_dir"
