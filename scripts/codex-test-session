#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
session_home="$(mktemp -d "${TMPDIR:-/tmp}/codex-test-session.XXXXXX")"

echo "Test HOME: $session_home"

HOME="$session_home" CODEX_HOME="$session_home/.codex" \
  "$repo_root/scripts/sync-codex"

echo
echo "Managed files:"
find "$session_home/.codex" -type f | sort
echo
echo "To enter the test session:"
echo "  HOME='$session_home' CODEX_HOME='$session_home/.codex' PATH='$session_home/.codex/bin:$PATH' bash"
