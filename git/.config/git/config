[core]
	excludesfile = ~/.config/git/ignore

[alias]
	s = status
	a = add
	aa = add .
	ap = add -p
	c = commit
	cm = commit -m
	ca = commit --amend
	can = commit --amend --no-edit
	sw = switch
	swc = switch -c
	b = branch
	bd = branch -d
	cur = branch --show-current
	d = diff
	dc = diff --cached
	lg = log --oneline --decorate --graph --all
	undo = reset --soft HEAD~1
	refl = reflog

# 個人の識別情報とマシン固有の上書き設定は dotfiles の外に置く。
[include]
	path = ~/.config/git/config.local
